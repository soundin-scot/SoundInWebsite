---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: 'website' | 'article';
  current?: 'vision' | 'ecosystem' | 'newsletter' | 'contact' | null;
  skipLink?: { href: string; label: string };
  chrome?: 'full' | 'minimal';
  robots?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  current = null,
  skipLink,
  chrome = 'full',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const ogImage = 'https://www.soundin.scot/og-image.png';
---

<!DOCTYPE html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content={robots} />
    <meta name="author" content="Cougar Macdougall" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-GB" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SoundIn" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="SoundIn: infrastructure for Scotland after dark" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SoundIn: infrastructure for Scotland after dark" />

    <meta name="geo.region" content="GB-SCT" />
    <meta name="geo.placename" content="Scotland" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    {skipLink && (
      <a href={skipLink.href} class="sr-only skip-link">{skipLink.label}</a>
    )}

    {chrome === 'full' && <Nav current={current} />}

    <slot />

    {chrome === 'full' && <Footer />}
  </body>
</html>
