---
import Logo from '@/components/Logo.astro';

type NavKey = 'vision' | 'ecosystem' | 'newsletter' | 'contact' | null;
interface Props { current?: NavKey; }
const { current = null } = Astro.props;

const links: { key: Exclude<NavKey, null>; label: string; href: string; index: string }[] = [
  { key: 'vision', label: 'Vision', href: '/vision', index: '01' },
  { key: 'ecosystem', label: 'Products', href: '/ecosystem', index: '02' },
  { key: 'newsletter', label: 'Notes', href: '/newsletter', index: '03' },
  { key: 'contact', label: 'Contact', href: '/contact', index: '04' },
];
---

<nav class="site-nav" aria-label="Site navigation">
  <Logo />

  <ul class="site-nav__links">
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
          <span>{link.index}</span>{link.label}
        </a>
      </li>
    ))}
  </ul>

  <a class="site-nav__access" href="/ecosystem#holocron">
    Explore Holocron <span aria-hidden="true">→</span>
  </a>
</nav>

<style>
  .site-nav {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    height: 78px;
    padding: 0 clamp(18px, 3vw, 46px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    color: #f0ede9;
    background: rgba(0, 0, 0, .96);
    border-bottom: 1px solid rgba(255, 255, 255, .12);
  }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    list-style: none;
  }
  .site-nav__links a,
  .site-nav__access {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .site-nav__links a { display: inline-flex; align-items: baseline; gap: 6px; opacity: 0.68; }
  .site-nav__links a > span { font-size: 7px; opacity: 0.58; }
  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] { opacity: 1; }
  .site-nav__access { justify-self: end; display: inline-flex; gap: 10px; }
  .site-nav a { transition: opacity 160ms ease; }
  .site-nav a:focus-visible { outline: 1px solid currentColor; outline-offset: 6px; }

  @media (max-width: 860px) {
    .site-nav { grid-template-columns: 1fr auto; height: 68px; color: #f0ede9; background: rgba(0,0,0,.96); border-bottom: 1px solid rgba(255,255,255,.14); }
    .site-nav__links { display: flex; gap: 17px; }
    .site-nav__links a { font-size: 8px; opacity: .72; }
    .site-nav__links a > span { display: none; }
    .site-nav__access { display: none; }
  }
  @media (max-width: 420px) {
    .site-nav { padding-inline: 12px; }
    .site-nav__links { gap: 9px; }
    .site-nav__links a { font-size: 7px; }
  }
</style>
