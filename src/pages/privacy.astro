---
import Layout from '@/layouts/Layout.astro';

const title = 'Privacy Notice: SoundIn';
const description = 'How SoundIn Limited collects, uses, and protects your personal data. Plain-English summary of our UK GDPR obligations.';

const lastUpdated = 'July 2026';

const sections = [
  {
    num: '01',
    heading: 'Who we are',
    body: [
      "SoundIn Limited (Companies House SC850719), based in Scotland, is the data controller for any personal information you share with us through this site or by email.",
      "If you have a question about this notice or your data, email Cougar Macdougall at cougar@soundin.scot.",
    ],
  },
  {
    num: '02',
    heading: 'What we collect',
    body: [
      "When you submit the contact form, we receive your name, email address, optional company name and the message you send us. We use that information to reply and keep a record of our discussions.",
      "When you subscribe to SoundIn Notes, we collect your email address, the time and source of the request, and the time you confirm it. We use that record to demonstrate your consent. You can unsubscribe from any issue or email cougar@soundin.scot.",
      "Like most sites, our hosting provider records standard server logs (IP address, user agent, request path) for security and reliability. We do not use those logs for marketing.",
    ],
  },
  {
    num: '03',
    heading: 'Why we use it',
    body: [
      "We use contact form submissions to reply to enquiries, understand possible work and keep a record of our discussions. Our lawful basis is legitimate interests: responding to people who choose to contact us and running our business.",
      "We use newsletter email addresses only to send SoundIn Notes and related updates after you confirm your subscription. Our lawful basis is consent, which you can withdraw at any time.",
      "We do not sell your data. Service providers that host this site, store enquiry and subscription records, or deliver email may process data on our behalf and may use it only as we direct. We do not share your data with another third party unless you have explicitly agreed, for example when asking us to introduce you to a partner.",
    ],
  },
  {
    num: '04',
    heading: 'How long we keep it',
    body: [
      "We delete enquiries that do not become engagements within 12 months. We keep records linked to active or completed engagements for the duration of the working relationship, then for seven years to meet UK accounting and tax obligations. We keep newsletter email addresses until you withdraw consent or ask us to delete them.",
    ],
  },
  {
    num: '05',
    heading: 'Your rights',
    body: [
      "Under UK GDPR, you can ask for a copy of the personal data we hold about you, ask us to correct or delete it, or object to how we use it. Email cougar@soundin.scot and we will respond within one month.",
      "You also have the right to complain to the Information Commissioner's Office (ico.org.uk).",
    ],
  },
  {
    num: '06',
    heading: 'Cookies and tracking',
    body: [
      "This site does not use marketing cookies, advertising trackers, or third-party analytics that profile you. We may add lightweight, privacy-respecting analytics in future; if we do, we will update this notice before doing so.",
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  canonical="https://soundin.scot/privacy"
  current={null}
  skipLink={{ href: '#privacy-content', label: 'Skip to content' }}
>
  <header class="privacy-hero" id="privacy-content" tabindex="-1">
    <div class="privacy-hero__meta">
      <span>Legal / data</span>
      <span>SoundIn Limited</span>
    </div>
    <h1>Privacy<br />notice.</h1>
    <div class="privacy-hero__foot">
      <p>How we collect, use and protect the information you choose to share with us.</p>
      <p>Last updated {lastUpdated}</p>
    </div>
  </header>

  <main class="privacy-body">
    {sections.map((s) => (
      <section class="privacy-row">
        <span class="privacy-row__num">{s.num}</span>
        <h2>{s.heading}</h2>
        <div class="privacy-row__body">
          {s.body.map((p) => <p>{p}</p>)}
        </div>
      </section>
    ))}
  </main>
</Layout>

<style>
  .privacy-hero {
    position: relative;
    min-height: 100svh;
    padding: 170px clamp(18px, 4vw, 64px) 64px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 77% 42%, rgba(255,255,255,.065), transparent 45%), #050505;
    border-bottom: 1px solid var(--color-ghost);
  }

  .privacy-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .2;
    background-image: linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);
    background-size: clamp(48px, 6vw, 96px) clamp(48px, 6vw, 96px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000);
    mask-image: linear-gradient(90deg, transparent, #000);
  }

  .privacy-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: min(70vw, 1000px);
    aspect-ratio: 1;
    top: 5%;
    right: -18%;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 50%;
    box-shadow: 0 0 0 9vw rgba(255,255,255,.018), 0 0 0 20vw rgba(255,255,255,.01);
  }

  .privacy-hero__meta,
  .privacy-hero__foot {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .privacy-hero h1 {
    margin: 72px 0;
    font-family: var(--font-sans);
    font-size: clamp(78px, 13vw, 210px);
    font-weight: 600;
    letter-spacing: -.055em;
    line-height: .8;
    color: var(--color-snow);
  }

  .privacy-hero__foot { align-items: end; }
  .privacy-hero__foot p:first-child {
    max-width: 520px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-cream);
  }

  .privacy-body { padding: 0 clamp(18px, 4vw, 64px) 120px; }

  .privacy-row {
    display: grid;
    grid-template-columns: 64px minmax(220px, .7fr) minmax(360px, 1.3fr);
    gap: clamp(28px, 5vw, 88px);
    padding: clamp(48px, 6vw, 80px) 0;
    border-bottom: 1px solid var(--color-ghost);
  }

  .privacy-row__num {
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }

  .privacy-row h2 {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3vw, 48px);
    font-weight: 560;
    letter-spacing: -.03em;
    line-height: 1.05;
    color: var(--color-snow);
  }

  .privacy-row__body { max-width: 760px; }
  .privacy-row__body p {
    margin-bottom: 20px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-cream);
  }
  .privacy-row__body p:last-child { margin-bottom: 0; }

  @media (max-width: 900px) {
    .privacy-hero { min-height: 100svh; padding-top: 140px; }
    .privacy-row { grid-template-columns: 44px 1fr; }
    .privacy-row__body { grid-column: 2; }
  }

  @media (max-width: 600px) {
    .privacy-hero { min-height: 100svh; padding: 124px 18px 40px; }
    .privacy-hero::before { -webkit-mask-image: linear-gradient(180deg, transparent, #000); mask-image: linear-gradient(180deg, transparent, #000); }
    .privacy-hero::after { width: 120vw; top: 18%; right: -58%; }
    .privacy-hero__meta span:last-child { display: none; }
    .privacy-hero h1 { margin: 56px 0; font-size: clamp(72px, 25vw, 108px); }
    .privacy-hero__foot { flex-direction: column; align-items: flex-start; }
    .privacy-body { padding-inline: 18px; padding-bottom: 80px; }
    .privacy-row { grid-template-columns: 30px 1fr; gap: 16px; padding: 44px 0; }
    .privacy-row__body { grid-column: 1 / -1; padding-left: 46px; }
  }
</style>
