---
import Layout from '@/layouts/Layout.astro';
import RevealScript from '@/components/RevealScript.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('newsletter');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} | SoundIn Newsletter`;
const canonical = `https://www.soundin.scot/newsletter/${post.id}`;

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#blog-post`,
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.publishedAt.toISOString(),
  url: canonical,
  isPartOf: { '@id': 'https://www.soundin.scot/newsletter#blog' },
  publisher: { '@id': 'https://www.soundin.scot/#organization' },
  author: { '@id': 'https://www.soundin.scot/#organization' },
  keywords: post.data.tags.join(', '),
};
---

<Layout
  title={title}
  description={post.data.summary}
  canonical={canonical}
  ogType="article"
  current={null}
  skipLink={{ href: '#post-content', label: 'Skip to content' }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} slot="head" />

  <article class="post" id="post-content" tabindex="-1">
    <header class="post-header">
      <a href="/newsletter" class="post-back">
        <span aria-hidden="true">←</span> Back to the archive
      </a>
      <div class="post-meta">
        <span class="post-issue">№ {String(post.data.issue).padStart(2, '0')}</span>
        <time datetime={post.data.publishedAt.toISOString()} class="post-date">
          {dateFmt.format(post.data.publishedAt)}
        </time>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-summary">{post.data.summary}</p>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-footer">
      <h2 class="post-footer-headline">Get the next note <span class="accent">when it is ready.</span></h2>
      <a href="/newsletter#newsletter-signup" class="cta-button">Subscribe <span aria-hidden="true">→</span></a>
    </footer>
  </article>

  <RevealScript />
</Layout>

<style>
  .post {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 200px 24px 120px;
  }

  .post-header { margin-bottom: 64px; }

  .post-back {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 48px;
    transition: color 0.3s ease, gap 0.3s ease;
  }
  .post-back:hover { color: var(--color-salmon); gap: 10px; }
  .post-back:focus-visible {
    color: var(--color-salmon);
    outline: 2px solid var(--color-salmon);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }

  .post-issue {
    font-family: var(--font-mono);
    font-weight: 400;
    font-style: normal;
    font-size: 22px;
    color: var(--color-salmon);
  }

  .post-date {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .post-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-style: normal;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.05;
    color: var(--color-snow);
    margin-bottom: 24px;
    text-wrap: balance;
  }

  .post-summary {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--color-cream);
    text-wrap: balance;
  }

  .post-body {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-cream);
  }

  .post-body :global(p) { margin: 0 0 24px; }
  .post-body :global(h2) {
    font-family: var(--font-sans);
    font-weight: 560;
    font-style: normal;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.1;
    color: var(--color-snow);
    margin: 56px 0 20px;
  }
  .post-body :global(h3) {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-snow);
    margin: 40px 0 16px;
  }
  .post-body :global(a) {
    color: var(--color-salmon);
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    transition: border-color 0.3s ease;
  }
  .post-body :global(a:hover) { border-bottom-color: var(--color-salmon); }
  .post-body :global(blockquote) {
    border-left: 2px solid var(--color-salmon);
    padding-left: 24px;
    margin: 32px 0;
    font-style: normal;
    color: var(--color-snow);
  }
  .post-body :global(em) { color: var(--color-snow); font-style: normal; font-weight: 600; }
  .post-body :global(ul), .post-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .post-body :global(li) { margin-bottom: 8px; }
  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.3);
    padding: 2px 6px;
    border-radius: 4px;
  }
  [data-theme="light"] .post-body :global(code) {
    background: rgba(36, 48, 44, 0.08);
  }
  .post-body :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(231, 223, 217, 0.13) 20%, rgba(231, 223, 217, 0.13) 80%, transparent);
    margin: 48px 0;
  }
  [data-theme="light"] .post-body :global(hr) {
    background: linear-gradient(to right, transparent, rgba(36, 48, 44, 0.13) 20%, rgba(36, 48, 44, 0.13) 80%, transparent);
  }

  /* Footer CTA */
  .post-footer {
    margin-top: 96px;
    padding-top: 64px;
    border-top: 1px solid transparent;
    border-image: linear-gradient(to right, transparent 0%, rgba(231, 223, 217, 0.12) 15%, rgba(231, 223, 217, 0.12) 85%, transparent 100%) 1;
    text-align: center;
  }

  [data-theme="light"] .post-footer {
    border-image: linear-gradient(to right, transparent 0%, rgba(36, 48, 44, 0.12) 15%, rgba(36, 48, 44, 0.12) 85%, transparent 100%) 1;
  }

  .post-footer-headline {
    font-family: var(--font-sans);
    font-weight: 560;
    font-style: normal;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.1;
    color: var(--color-snow);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .post-footer-headline .accent { color: var(--color-salmon); }

  @media (max-width: 600px) {
    .post { padding: 140px 24px 80px; }
    .post-header { margin-bottom: 48px; }
  }
</style>

<style>
  /* Editorial article shell shared with the 2026 site identity. */
  .post.post {
    max-width: none;
    margin: 0;
    padding: 170px clamp(18px, 4vw, 64px) 120px;
  }

  .post .post-header {
    position: relative;
    min-height: calc(100svh - 290px);
    display: grid;
    grid-template-columns: minmax(180px, .35fr) minmax(520px, 1fr);
    align-content: end;
    column-gap: clamp(48px, 9vw, 160px);
    margin: 0;
    padding-bottom: clamp(64px, 8vw, 112px);
    border-bottom: 1px solid var(--color-ghost);
  }

  .post .post-back {
    position: absolute;
    top: 0;
    left: 0;
    grid-column: 1;
    align-self: start;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .05em;
  }

  .post .post-meta {
    grid-column: 2;
    grid-row: 1;
    margin: 0 0 64px;
    gap: 28px;
  }

  .post .post-issue,
  .post .post-date {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    font-style: normal;
    letter-spacing: .05em;
    color: var(--color-muted);
  }

  .post .post-title,
  .post .post-summary {
    grid-column: 2;
  }

  .post .post-title {
    margin: 0;
    max-width: 1000px;
    font-family: var(--font-sans);
    font-size: clamp(58px, 8vw, 132px);
    font-weight: 600;
    font-style: normal;
    letter-spacing: -.05em;
    line-height: .93;
  }

  .post .post-summary {
    max-width: 720px;
    margin-top: 42px;
    font-size: clamp(17px, 1.6vw, 23px);
    line-height: 1.5;
  }

  .post .post-body {
    width: min(100%, 760px);
    margin: 0 0 0 auto;
    padding: clamp(64px, 8vw, 112px) 0;
    font-size: 16px;
    line-height: 1.8;
  }

  .post .post-body :global(h2) {
    margin: 72px 0 24px;
    font-family: var(--font-sans);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 560;
    font-style: normal;
    letter-spacing: -.035em;
    line-height: 1.05;
  }

  .post .post-body :global(h3) {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 560;
    letter-spacing: -.02em;
  }

  .post .post-body :global(a) { color: var(--color-snow); }
  .post .post-body :global(blockquote) {
    margin: 48px 0;
    padding: 8px 0 8px 28px;
    border-left: 1px solid var(--color-snow);
    font-family: var(--font-sans);
    font-size: clamp(21px, 2.4vw, 30px);
    font-style: normal;
    letter-spacing: -.025em;
    line-height: 1.35;
  }

  .post .post-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 48px;
    margin: 0;
    padding: 72px 0 0;
    border-top: 1px solid var(--color-ghost);
    border-image: none;
    text-align: left;
  }

  .post .post-footer-headline {
    max-width: 800px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 76px);
    font-weight: 560;
    font-style: normal;
    letter-spacing: -.04em;
    line-height: 1.02;
  }

  .post .post-footer-headline .accent { color: inherit; }

  @media (max-width: 800px) {
    .post.post { padding-top: 140px; }
    .post .post-header { grid-template-columns: 1fr; }
    .post .post-back,
    .post .post-meta,
    .post .post-title,
    .post .post-summary { grid-column: 1; }
    .post .post-back { position: static; grid-row: auto; margin-bottom: 52px; }
    .post .post-meta { grid-row: auto; margin-bottom: 36px; }
    .post .post-footer { grid-template-columns: 1fr; align-items: start; }
    .post .post-footer .cta-button { width: max-content; }
  }

  @media (max-width: 600px) {
    .post.post { padding: 124px 18px 80px; }
    .post .post-title { font-size: clamp(52px, 17vw, 76px); }
    .post .post-body { padding: 64px 0; }
    .post .post-footer { padding-top: 52px; gap: 28px; }
  }
</style>
