---
import Layout from '@/layouts/Layout.astro';
import NightRecord from '@/components/NightRecord.astro';
import SoundObject from '@/components/SoundObject.astro';

const title = 'SoundIn — Infrastructure for Scotland after dark';
const description = 'SoundIn builds calm, accountable operational software for the people responsible for Scotland’s night-time economy.';

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'LocalBusiness'],
      '@id': 'https://soundin.scot/#organization',
      name: 'SoundIn',
      legalName: 'SoundIn Limited',
      url: 'https://soundin.scot',
      email: 'cougar@soundin.scot',
      foundingDate: '2025',
      description,
      identifier: { '@type': 'PropertyValue', name: 'Companies House', value: 'SC850719' },
      address: { '@type': 'PostalAddress', addressRegion: 'Scotland', addressCountry: 'GB' },
      founder: [{ '@type': 'Person', name: 'Cougar Macdougall' }],
      areaServed: [{ '@type': 'AdministrativeArea', name: 'Scotland' }],
      sameAs: ['https://www.linkedin.com/company/soundin-ltd'],
    },
  ],
};

const recordStages = [
  ['21:00', 'Briefing', 'Before doors open, everyone agrees the plan, their role and who owns each decision.'],
  ['22:00', 'Entry', 'Headcounts and guest-list decisions move into one live record.'],
  ['00:20', 'Floor', 'Incidents are assigned, resolved and kept with their context.'],
  ['03:00', 'Close', 'Settlements and follow-up actions remain visible after the room empties.'],
];
---

<Layout
  title={title}
  description={description}
  canonical="https://soundin.scot/"
  skipLink={{ href: '#main-content', label: 'Skip to main content' }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} slot="head" />

  <main class="home" id="main-content">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <div class="hero-eyebrow">
          <span>Independent software company</span>
          <span>Scotland / 56°N</span>
        </div>

        <h1 id="home-title">Infrastructure for Scotland <span>after dark.</span></h1>

        <div class="hero-intro">
          <p>SoundIn builds operational software for Scotland’s venues, promoters and security teams. Holocron gives them one accountable record, from briefing to close.</p>
          <div class="hero-actions">
            <a class="button-primary" href="/ecosystem">Explore Holocron <span aria-hidden="true">↗</span></a>
            <a class="button-text" href="/vision">Our point of view <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <ul class="hero-facts" aria-label="SoundIn facts">
          <li><span>01</span>Built in Scotland</li>
          <li><span>02</span>Independent and founder-led</li>
          <li><span>03</span>Founding access open</li>
        </ul>
      </div>

      <div class="home-hero__record">
        <NightRecord />
      </div>
    </section>

    <div class="operational-rail" aria-label="The operational record">
      <div>
        <span>Briefing</span><i>01</i><span>Entry</span><i>02</i><span>Incidents</span><i>03</i><span>Guests</span><i>04</i><span>Settlement</span><i>05</i><span>Close</span><i>06</i>
        <span>Briefing</span><i>01</i><span>Entry</span><i>02</i><span>Incidents</span><i>03</i><span>Guests</span><i>04</i><span>Settlement</span><i>05</i><span>Close</span><i>06</i>
      </div>
    </div>

    <section class="thesis" aria-labelledby="thesis-title">
      <header class="section-label">
        <span>01 / Why SoundIn</span>
        <span>Systems for live environments</span>
      </header>

      <div class="thesis__statement">
          <h2 id="thesis-title">The night is live.<br />Its systems are not.</h2>
        <p>Most nights still depend on disconnected tools and private messages. SoundIn gives the people in charge one calm, shared record of what happened and what needs to happen next.</p>
      </div>

      <ol class="record-sequence">
        {recordStages.map(([time, title, body], index) => (
          <li>
            <span class="record-sequence__index">0{index + 1}</span>
            <time>{time}</time>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="holocron" aria-labelledby="holocron-title">
      <header class="section-label section-label--dark">
        <span>02 / First product</span>
        <span>Founding access / 2026</span>
      </header>

      <div class="holocron__headline">
        <div>
          <span class="product-kicker">Venue operations</span>
          <h2 id="holocron-title">Holocron</h2>
        </div>
        <p>One operational record for the whole night. Keep attendance, incidents, guest lists, ticketing and settlements together, without creating more admin.</p>
      </div>

      <div class="holocron__theatre">
        <div class="holocron__object"><SoundObject /></div>

        <div class="holocron__spec">
          <div class="spec-intro">
            <span>H/01</span>
            <p>Built around how an event actually unfolds, not how a generic CRM expects it to.</p>
          </div>

          <dl>
            <div><dt>Designed for</dt><dd>Venues operating under Scottish licensing law.</dd></div>
            <div><dt>Shared with</dt><dd>Promoters, artists, production teams and security.</dd></div>
            <div><dt>One record</dt><dd>Attendance, incidents, guest lists and settlements.</dd></div>
            <div><dt>Working principle</dt><dd>Clear during the night. Accountable the next morning.</dd></div>
          </dl>

          <div class="holocron__links">
            <a class="button-primary button-primary--light" href="/ecosystem#holocron">Explore Holocron <span aria-hidden="true">→</span></a>
            <a class="button-text" href="/contact">Tell us how your venue works <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <header class="section-label">
        <span>03 / Principles</span>
        <span>How we make</span>
      </header>

      <h2 id="principles-title">Software should lower the temperature.</h2>

      <div class="principles__grid">
        <article>
          <span>01</span>
          <h3>Calm under pressure</h3>
          <p>As the room gets louder, the interface should get quieter. The next responsible action should always be clear.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Accountable by design</h3>
          <p>Important decisions need context, an owner and a record that lasts. They should not disappear into another message thread.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Made for the people on the floor</h3>
          <p>We build around the people carrying the responsibility, the real order of the night and the limits they work within.</p>
        </article>
      </div>
    </section>

    <section class="home-cta" aria-labelledby="cta-title">
      <div class="home-cta__meta"><span>Founding cohort</span><span>Scotland / 2026</span></div>
      <h2 id="cta-title">Build a better record of the night.</h2>
      <div class="home-cta__footer">
        <p>We’re working with independent venues and operators to shape Holocron’s first release.</p>
        <a href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html), :global(body) { background: #0a0a0a; }
  .home { color: #111; background: #efeee8; }
  .home-hero {
    position: relative;
    min-height: 100svh;
    padding: 118px clamp(18px, 3vw, 46px) 42px;
    color: #f0efe9;
    background: #050505;
    overflow: hidden;
    isolation: isolate;
  }
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(5,5,5,.98) 0%, rgba(5,5,5,.9) 42%, rgba(5,5,5,.18) 75%, rgba(5,5,5,.48) 100%), linear-gradient(0deg, rgba(5,5,5,.9), transparent 46%);
    pointer-events: none;
  }
  .home-hero__copy { position: relative; z-index: 2; min-height: calc(100svh - 160px); display: flex; flex-direction: column; }
  .hero-eyebrow,
  .section-label,
  .home-cta__meta {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .hero-eyebrow { padding-top: 5px; color: rgba(240,239,233,.72); }
  .hero-eyebrow span:last-child { opacity: .52; }
  .home-hero h1 {
    max-width: 1120px;
    margin-top: auto;
    font-size: clamp(76px, 9.4vw, 164px);
    font-weight: 600;
    letter-spacing: -.055em;
    line-height: .84;
    text-wrap: balance;
  }
  .home-hero h1 span { display: block; font-weight: 450; color: rgba(240,239,233,.62); }
  .hero-intro {
    max-width: 880px;
    margin-top: clamp(38px, 5vh, 72px);
    padding-top: 20px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 34px;
    border-top: 1px solid rgba(255,255,255,.34);
  }
  .hero-intro p { max-width: 560px; color: rgba(240,239,233,.72); font-size: 15px; line-height: 1.62; }
  .hero-actions { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 20px; }
  .button-primary,
  .button-text {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  .button-primary { min-width: 174px; padding: 14px 15px; color: #f0efe9; background: #111; border: 1px solid #111; }
  .button-primary--light { color: #111; background: #efeee8; border-color: #efeee8; }
  .button-text { padding: 14px 0 9px; border-bottom: 1px solid currentColor; }
  .button-primary,
  .button-text { transition: opacity 160ms ease; }
  .button-primary:hover,
  .button-text:hover { opacity: .58; }
  .button-primary:focus-visible,
  .button-text:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .home-hero .button-primary { color: #111; background: #f0efe9; border-color: #f0efe9; }
  .home-hero .button-text { color: #f0efe9; }
  .hero-facts { max-width: 880px; margin-top: 36px; display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; border-top: 1px solid rgba(255,255,255,.34); }
  .hero-facts li { padding: 12px 12px 0 0; font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; }
  .hero-facts span { margin-right: 8px; opacity: .4; }
  .home-hero__record {
    position: absolute;
    z-index: 0;
    inset: 0 0 0 auto;
    width: min(62vw, 980px);
    opacity: .56;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
  }
  :global(.home-hero__record .night-record) { height: 100%; min-height: 100svh; border: 0; }

  .operational-rail { overflow: hidden; color: #efeee8; background: #111; border-top: 1px solid #111; border-bottom: 1px solid #111; }
  .operational-rail > div { width: max-content; padding: 14px 0; display: flex; align-items: center; animation: rail 34s linear infinite; }
  .operational-rail span { padding: 0 31px; font-size: 11px; text-transform: uppercase; }
  .operational-rail i { font-family: var(--font-mono); font-size: 7px; font-style: normal; opacity: .42; }
  @keyframes rail { to { transform: translateX(-50%); } }

  .thesis,
  .principles { padding: 52px clamp(18px, 3vw, 46px) 120px; color: #efeee8; background: #111; }
  .section-label { padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,.3); }
  .section-label span:last-child { opacity: .45; }
  .section-label--dark { border-color: rgba(0,0,0,.3); }
  .thesis__statement { padding: 110px 0 150px; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, .6fr); gap: 90px; align-items: end; }
  .thesis__statement h2,
  .principles > h2,
  .home-cta h2 {
    font-size: clamp(62px, 8.4vw, 146px);
    font-weight: 560;
    letter-spacing: -.05em;
    line-height: .91;
  }
  .thesis__statement p { max-width: 500px; color: rgba(239,238,232,.6); font-size: 16px; line-height: 1.7; }
  .record-sequence { list-style: none; border-top: 1px solid rgba(255,255,255,.3); }
  .record-sequence li { min-height: 112px; display: grid; grid-template-columns: 50px 90px 1fr minmax(280px, .7fr); align-items: center; gap: 20px; border-bottom: 1px solid rgba(255,255,255,.3); }
  .record-sequence__index,
  .record-sequence time { font-family: var(--font-mono); font-size: 8px; opacity: .44; }
  .record-sequence h3 { font-size: clamp(28px, 3vw, 48px); font-weight: 500; letter-spacing: -.03em; line-height: 1.04; }
  .record-sequence p { max-width: 490px; color: rgba(239,238,232,.54); font-size: 13px; line-height: 1.58; }

  .holocron { padding: 52px clamp(18px, 3vw, 46px) 130px; color: #111; background: #d9d8d2; }
  .holocron__headline { padding: 80px 0 100px; display: grid; grid-template-columns: 1.25fr .75fr; gap: 80px; align-items: end; }
  .product-kicker { display: block; margin-bottom: 22px; font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; }
  .holocron__headline h2 { font-size: clamp(86px, 12vw, 210px); font-weight: 620; letter-spacing: -.055em; line-height: .78; }
  .holocron__headline > p { max-width: 540px; font-size: 16px; line-height: 1.65; }
  .holocron__theatre { display: grid; grid-template-columns: 1fr 1fr; min-height: 720px; border: 1px solid rgba(0,0,0,.42); }
  .holocron__object { display: grid; place-items: center; border-right: 1px solid rgba(0,0,0,.42); overflow: hidden; }
  :global(.holocron__object .signal-object) { width: min(38vw, 520px); }
  .holocron__spec { padding: 28px; display: flex; flex-direction: column; }
  .spec-intro { display: flex; justify-content: space-between; gap: 30px; }
  .spec-intro span,
  .spec-intro p,
  .holocron__spec dt { font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; }
  .spec-intro p { max-width: 260px; line-height: 1.6; }
  .holocron__spec dl { margin-top: auto; border-top: 1px solid rgba(0,0,0,.35); }
  .holocron__spec dl > div { display: grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 17px 0; border-bottom: 1px solid rgba(0,0,0,.35); }
  .holocron__spec dt { opacity: .5; }
  .holocron__spec dd { font-size: 13px; line-height: 1.45; }
  .holocron__links { padding-top: 28px; display: flex; justify-content: space-between; align-items: flex-start; gap: 30px; }

  .principles { padding-top: 52px; }
  .principles > h2 { max-width: 1100px; padding: 120px 0; }
  .principles__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.3); border-left: 1px solid rgba(255,255,255,.3); }
  .principles article { min-height: 380px; padding: 22px; display: flex; flex-direction: column; border-right: 1px solid rgba(255,255,255,.3); border-bottom: 1px solid rgba(255,255,255,.3); }
  .principles article > span { font-family: var(--font-mono); font-size: 8px; opacity: .45; }
  .principles h3 { margin-top: auto; font-size: clamp(28px, 3vw, 48px); font-weight: 500; letter-spacing: -.03em; line-height: 1.04; }
  .principles article p { max-width: 360px; margin-top: 22px; color: rgba(239,238,232,.54); font-size: 13px; line-height: 1.6; }

  .home-cta { min-height: 760px; padding: 52px clamp(18px, 3vw, 46px); display: flex; flex-direction: column; color: #111; background: #efeee8; }
  .home-cta__meta { padding-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,.3); }
  .home-cta h2 { max-width: 1200px; margin: auto 0; }
  .home-cta__footer { padding-top: 22px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 40px; border-top: 1px solid rgba(0,0,0,.3); }
  .home-cta__footer p { max-width: 460px; font-size: 14px; line-height: 1.6; }
  .home-cta__footer a { display: inline-flex; gap: 60px; padding-bottom: 8px; border-bottom: 1px solid; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; }

  @media (max-width: 1040px) {
    .home-hero__record { width: 78vw; opacity: .42; }
    .thesis__statement,
    .holocron__headline { grid-template-columns: 1fr; }
    .record-sequence li { grid-template-columns: 40px 70px 1fr; padding: 22px 0; }
    .record-sequence p { grid-column: 3; }
  }

  @media (max-width: 760px) {
    .home-hero { padding-top: 92px; }
    .home-hero__copy { min-height: calc(100svh - 134px); }
    .home-hero h1 { font-size: 15vw; line-height: .9; }
    .hero-intro { grid-template-columns: 1fr; }
    .hero-facts { grid-template-columns: 1fr; gap: 12px; padding-top: 14px; }
    .hero-facts li { padding: 0; }
    .home-hero__record { width: 120vw; right: -50vw; opacity: .32; }
    .thesis,
    .principles,
    .holocron { padding-bottom: 82px; }
    .thesis__statement { padding: 86px 0 100px; gap: 48px; }
    .thesis__statement h2,
    .principles > h2,
    .home-cta h2 { font-size: 16vw; }
    .record-sequence li { grid-template-columns: 34px 58px 1fr; gap: 12px; }
    .record-sequence h3 { font-size: 28px; }
    .record-sequence p { grid-column: 2 / -1; }
    .holocron__headline { padding: 70px 0 80px; gap: 48px; }
    .holocron__headline h2 { font-size: 24vw; }
    .holocron__theatre { grid-template-columns: 1fr; }
    .holocron__object { min-height: 500px; border-right: 0; border-bottom: 1px solid rgba(0,0,0,.42); }
    :global(.holocron__object .signal-object) { width: min(78vw, 420px); }
    .holocron__spec { min-height: 600px; padding: 20px; }
    .holocron__links { flex-direction: column; }
    .principles > h2 { padding: 90px 0; }
    .principles__grid { grid-template-columns: 1fr; }
    .principles article { min-height: 300px; }
    .home-cta { min-height: 650px; }
    .home-cta__footer { grid-template-columns: 1fr; }
    .home-cta__footer a { justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .operational-rail > div { animation: none; transform: translateX(-12%); }
  }
</style>
