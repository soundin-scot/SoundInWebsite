---
import Layout from '@/layouts/Layout.astro';

const title = 'Why SoundIn | Better systems for Scottish nightlife';
const description = 'SoundIn builds Holocron for DJs, artists, promoters, production and security teams in Scottish nightlife: one calm, accountable record from briefing to close.';

const sections = [
  {
    num: '01',
    heading: 'Nightlife runs on too many tools',
    body: [
      "Headcounts live on clickers. Incidents go into notebooks. Guest lists sit in WhatsApp. Settlements live in spreadsheets. Artist details disappear into email chains. Each tool tells only part of the story.",
      "That leaves artists unsure whether details are final, venue teams checking whether incidents were logged, and promoters and security working from different records. When someone needs to review the night, nobody can see the whole picture.",
    ],
  },
  {
    num: '02',
    heading: "One record. Everyone in it.",
    body: [
      "Everyone running the night works from the same Holocron record. DJs, artists, promoters, production and security teams can see the same booking details and follow the settlement. Security logs each incident once, directly into the compliance record.",
      "Martyn's Law is expected to come into force in 2027 and will raise the standard of preparedness for premises and events in scope. Holocron helps the people running events build good records into the way they already work, instead of treating compliance as a separate task. Over time, the same record can reveal peak hours, recurring incidents, effective staff combinations and revenue patterns. After ten events, Holocron begins to surface patterns that would otherwise take months to spot.",
    ],
  },
  {
    num: '03',
    heading: "Better tools should strengthen the whole scene",
    body: [
      "Holocron should strengthen the whole scene. Artists, promoters and security teams can use the shared records they need without buying a separate subscription. Everyone helping to run the night stays connected.",
      "Over time, those shared records become more useful. Artists can see their booking history. Venues can understand talent patterns. Promoters can coordinate without losing decisions in old group chats. Each team gets useful information back from the records it helps create.",
    ],
  },
  {
    num: '04',
    heading: 'Built with focus, in Scotland',
    body: [
      "I am building Holocron in Scotland because this is the scene I know and the place it needs to serve first. That is not a brand story. It is a practical point of view.",
      "Working alone does not mean thinking small. It forces me to be deliberate about what goes into the product, who I work with and where each hour goes. Holocron exists because venue operators I know needed better tools, and nobody was building for the way their nights actually work.",
      "Say what you mean. Charge what the work costs. Own mistakes. Take on less, then do it properly. Build things that last and remember the person on the other side of every contract.",
    ],
  },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://www.soundin.scot/vision#webpage',
  url: 'https://www.soundin.scot/vision',
  name: title,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://www.soundin.scot/#website' },
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.soundin.scot/vision"
  current="vision"
  skipLink={{ href: '#vision-content', label: 'Skip to content' }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutSchema)} slot="head" />

  <div class="page-hero" id="vision-content" tabindex="-1">
    <div class="page-hero-inner">
      <span class="page-hero-kicker">vision</span>
      <h1 class="page-hero-title">Built for Scotland after dark.</h1>
      <p class="page-hero-desc">The people who make nights happen have relied on WhatsApp and paper logbooks for long enough. Holocron gives every responsible team one record of the night.</p>
      <a class="vision-hero-action" href="/contact">Tell us how you work <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="vision-body">
    {sections.map((s) => (
      <section class="vsec">
        <header class="vsec-hd">
          <span class="vsec-num">{s.num}</span>
          <h2 class="vsec-title">{s.heading}</h2>
        </header>
        <div class="vsec-text">
          {s.body.map((p) => <p>{p}</p>)}
        </div>
      </section>
    ))}

    <div class="vision-cta">
      <p>If you DJ, perform, promote, work in production or security, we would like to hear how your nights work. Venue operations are planned, but the current trial is for People.</p>
      <a href="/contact" class="cta-button">Start a conversation <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</Layout>

<style>
  .vision-body {
    padding: 0 clamp(18px, 4vw, 64px) 120px;
  }

  .vision-hero-action {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 36px;
    padding: 14px 16px;
    color: var(--color-scarab);
    background: var(--color-snow);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .vision-hero-action:hover { opacity: .68; }
  .vision-hero-action:focus-visible { outline: 1px solid var(--color-snow); outline-offset: 5px; }

  .vsec {
    display: grid;
    grid-template-columns: minmax(320px, .9fr) minmax(360px, 1.1fr);
    gap: clamp(48px, 9vw, 160px);
    padding: clamp(64px, 7vw, 104px) 0;
    border-bottom: 1px solid var(--color-ghost);
  }

  .vsec:first-child { border-top: 1px solid var(--color-ghost); }

  .vsec-hd {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-content: start;
    gap: 24px;
  }

  .vsec-num {
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .05em;
    color: var(--color-muted);
  }

  .vsec-title {
    max-width: 540px;
    font-family: var(--font-sans);
    font-weight: 560;
    font-size: clamp(36px, 4vw, 64px);
    letter-spacing: -.035em;
    line-height: 1.03;
    color: var(--color-snow);
    text-wrap: balance;
  }

  .vsec-text p {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.72;
    color: var(--color-cream);
    margin-bottom: 24px;
  }

  .vsec-text p:last-child { margin-bottom: 0; }

  .vision-cta {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) auto;
    align-items: end;
    gap: 48px;
    padding: 72px 0 0;
  }

  .vision-cta p {
    max-width: 760px;
    font-family: var(--font-sans);
    font-weight: 560;
    font-size: clamp(32px, 4.5vw, 72px);
    letter-spacing: -.035em;
    line-height: 1.04;
    color: var(--color-snow);
  }

  @media (max-width: 900px) {
    .vision-body { padding: 0 24px 80px; }
    .vsec { grid-template-columns: 1fr; gap: 36px; }
    .vision-cta { grid-template-columns: 1fr; align-items: start; }
    .vision-cta .cta-button { width: max-content; }
  }

  @media (max-width: 600px) {
    .vision-body { padding-inline: 18px; }
    .vsec { padding: 48px 0; gap: 30px; }
    .vsec-hd { grid-template-columns: 36px 1fr; gap: 12px; }
    .vsec-num { padding-top: 5px; }
    .vision-cta { padding-top: 56px; gap: 28px; }
  }
</style>
