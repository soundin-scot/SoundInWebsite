---
import Layout from '@/layouts/Layout.astro';

const title = 'Holocron | Event operations for Scottish nightlife';
const description = 'Holocron brings attendance, incidents, guest lists, ticketing and settlements into one shared record for DJs, artists, promoters, production and security teams.';

const productSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://www.soundin.scot/ecosystem#webpage',
      name: title,
      description,
      url: 'https://www.soundin.scot/ecosystem',
      inLanguage: 'en-GB',
      isPartOf: { '@id': 'https://www.soundin.scot/#website' },
      mainEntity: { '@id': 'https://www.soundin.scot/ecosystem#holocron' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://www.soundin.scot/ecosystem#holocron',
      name: 'Holocron',
      description,
      url: 'https://www.soundin.scot/ecosystem#holocron',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      provider: { '@id': 'https://www.soundin.scot/#organization' },
      areaServed: { '@type': 'AdministrativeArea', name: 'Scotland' },
      audience: {
        '@type': 'Audience',
        audienceType: 'DJs, artists, promoters, production teams and security teams in Scotland’s night-time economy',
      },
      featureList: [
        'Shared records for DJs, artists, promoters, production teams and security teams',
        'Attendance records',
        'Incident management',
        'Guest lists',
        'Ticketing records',
        'Event settlements',
      ],
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="https://www.soundin.scot/ecosystem"
  current="ecosystem"
  skipLink={{ href: '#products', label: 'Skip to products' }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />

  <main id="products" class="products" tabindex="-1">
    <header class="products-header">
      <div class="products-header__meta">
        <span>Products</span>
        <span>01</span>
      </div>
      <h1>Operational systems for Scotland after dark.</h1>
      <p>
        SoundIn builds Holocron for People — DJs, artists, promoters, production and security teams — who make Scotland’s nights happen.
      </p>
      <div class="products-header__actions">
        <a class="product-primary-action" href="#holocron">See how Holocron works <span aria-hidden="true">→</span></a>
        <a class="product-secondary-action" href="/contact">Join the People waitlist <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <article class="product" id="holocron">
      <header class="product-header">
        <div>
          <span class="product-index">01</span>
          <h2>Holocron</h2>
          <p class="product-category">People-first event operations / Scotland</p>
        </div>
        <p class="product-summary">
          One operational record for the whole night. Holocron keeps attendance, incidents, guest lists, ticketing and settlements together, without creating more admin.
        </p>
      </header>

      <div class="product-details">
        <div>
          <span>For People</span>
          <p>DJs, artists, promoters, production teams and security teams.</p>
        </div>
        <div>
          <span>Small free trial</span>
          <p>Open through a rolling waitlist with no access deadline.</p>
        </div>
        <div>
          <span>Operational record</span>
          <p>Attendance, incidents, guest lists, ticketing and settlements.</p>
        </div>
        <div>
          <span>Venue side</span>
          <p>Venue operations remain planned, but are not part of the current trial.</p>
        </div>
      </div>

      <footer class="product-footer">
        <p>Holocron is SoundIn’s only product. The current focus is a small free trial for People.</p>
        <div>
          <a href="/contact">Join the People waitlist →</a>
        </div>
      </footer>
    </article>

    <section class="product-next" aria-labelledby="next-title">
      <div>
        <span>Focus</span>
      </div>
      <h2 id="next-title">One product, built with focus.</h2>
      <p>We’re inviting People into a small free trial through an open, rolling waitlist.</p>
      <a href="/contact">Join the waitlist →</a>
    </section>
  </main>
</Layout>

<style>
  .products { background: #000; color: #f0ede9; }

  .products-header {
    position: relative;
    min-height: 100svh;
    padding: 150px clamp(18px, 4vw, 64px) clamp(44px, 6vh, 76px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 76% 38%, rgba(255,255,255,.07), transparent 44%), #050505;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .products-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .2;
    background-image: linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px);
    background-size: clamp(48px, 6vw, 96px) clamp(48px, 6vw, 96px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000);
    mask-image: linear-gradient(90deg, transparent, #000);
  }

  .products-header::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: min(66vw, 940px);
    aspect-ratio: 1;
    top: 4%;
    right: -16%;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 50%;
    box-shadow: 0 0 0 9vw rgba(255,255,255,.018), 0 0 0 20vw rgba(255,255,255,.01);
  }

  .products-header__meta,
  .product-next > div {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    color: rgba(240, 237, 233, 0.46);
    font-size: 11px;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .products-header h1 {
    max-width: 1200px;
    margin-top: auto;
    padding-top: 84px;
    font-size: clamp(70px, 9.5vw, 160px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .products-header > p {
    max-width: 560px;
    margin-top: 44px;
    color: rgba(240, 237, 233, 0.62);
    font-size: 16px;
    line-height: 1.65;
  }
  .products-header__actions { display: flex; flex-wrap: wrap; gap: 18px 28px; margin-top: 34px; align-items: center; }
  .product-primary-action { display: inline-flex; gap: 14px; padding: 13px 16px; color: #000; background: #f0ede9; font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }
  .product-secondary-action { display: inline-flex; gap: 14px; color: rgba(240, 237, 233, 0.68); font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }
  .product-primary-action:hover { background: #fff; }
  .product-secondary-action:hover { color: #fff; }
  .product-primary-action:focus-visible, .product-secondary-action:focus-visible { outline: 1px solid #fff; outline-offset: 5px; }

  .product {
    padding: 80px 40px 110px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .product-header {
    padding: 64px 0 70px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .product-index,
  .product-category,
  .product-details span {
    font-family: var(--font-mono);
    color: rgba(240, 237, 233, 0.46);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-header h2 {
    margin-top: 18px;
    font-size: clamp(58px, 8vw, 126px);
    font-weight: 600;
    letter-spacing: -0.052em;
    line-height: 0.9;
  }

  .product-category { display: block; margin-top: 28px; }
  .product-summary { max-width: 610px; align-self: end; color: rgba(240, 237, 233, 0.72); font-size: clamp(20px, 2.2vw, 32px); line-height: 1.35; }

  .product-details {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .product-details > div { min-height: 190px; padding: 32px 28px 32px 0; border-right: 1px solid rgba(255, 255, 255, 0.14); }
  .product-details > div:not(:first-child) { padding-left: 28px; }
  .product-details > div:last-child { border-right: none; }
  .product-details p { max-width: 260px; margin-top: 44px; color: rgba(240, 237, 233, 0.66); font-size: 14px; line-height: 1.55; }

  .product-footer { padding-top: 34px; display: flex; justify-content: space-between; gap: 30px; color: rgba(240, 237, 233, 0.5); font-family: var(--font-mono); font-size: 10px; line-height: 1.6; }
  .product-footer > div { display: flex; gap: 34px; }
  .product-footer a { color: #f0ede9; }
  .product a { transition: opacity 0.25s ease; }
  .product a:hover { opacity: 0.6; }
  .product a:focus-visible { outline: 1px solid #fff; outline-offset: 5px; }

  .product-next {
    min-height: 680px;
    padding: 90px 40px 120px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .product-next > div { margin-bottom: auto; }
  .product-next h2 { max-width: 860px; font-size: clamp(54px, 7vw, 112px); font-weight: 560; letter-spacing: -0.05em; line-height: 0.94; }
  .product-next > p { max-width: 560px; margin-top: 38px; color: rgba(240, 237, 233, 0.6); font-size: 15px; line-height: 1.7; }
  .product-next > a { width: max-content; margin-top: 36px; color: #f0ede9; font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }

  @media (max-width: 760px) {
    .products-header { min-height: 100svh; padding: 130px 18px 48px; }
    .products-header::before { -webkit-mask-image: linear-gradient(180deg, transparent, #000); mask-image: linear-gradient(180deg, transparent, #000); }
    .products-header::after { width: 120vw; top: 18%; right: -58%; }
    .products-header h1 { font-size: 17vw; }
    .products-header__actions { margin-top: 28px; }
    .product { padding: 44px 18px 80px; }
    .product-header { padding: 50px 0; grid-template-columns: 1fr; gap: 45px; }
    .product-details { grid-template-columns: repeat(2, 1fr); }
    .product-details > div { min-height: 175px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
    .product-details > div:nth-child(2) { border-right: none; }
    .product-details > div:nth-child(3),
    .product-details > div:nth-child(4) { border-bottom: none; }
    .product-details > div:nth-child(3) { padding-left: 0; }
    .product-details p { margin-top: 28px; font-size: 12px; }
    .product-footer { flex-direction: column; }
    .product-next { min-height: 580px; padding: 70px 18px 90px; }
  }
</style>
